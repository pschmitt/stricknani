{
  "name": "stricknani-web",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:e2e",
    "check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed": "node e2e/lib/run-ts.mjs e2e/lib/seed-cli.ts",
    "fixture": "node e2e/lib/run-ts.mjs e2e/lib/fixture-cli.ts",
    "replay": "node e2e/lib/run-ts.mjs e2e/lib/replay.ts",
    "summarize-e2e": "node e2e/lib/run-ts.mjs e2e/lib/summarize-e2e.ts",
    "verify-import": "node e2e/lib/run-ts.mjs e2e/lib/verify-import.ts",
    "format:check": "prettier --check .",
    "build": "vite build && node scripts/write-csp-manifest.mjs",
    "preview": "vite preview",
    "i18n:extract": "node scripts/i18n/babel.mjs extract && node scripts/i18n/extract-rust.mjs && node scripts/i18n/generate-web.mjs --extract",
    "i18n:update": "npm run --silent i18n:extract && node scripts/i18n/babel.mjs update && node scripts/i18n/generate-rust.mjs --seed-german && node scripts/i18n/generate-rust.mjs && node scripts/i18n/generate-web.mjs --update",
    "i18n:compile": "node scripts/i18n/babel.mjs compile && node scripts/i18n/generate-rust.mjs && node scripts/i18n/generate-web.mjs",
    "i18n:check": "node scripts/i18n/check-translations.mjs && node scripts/i18n/generate-rust.mjs --check && node scripts/i18n/generate-web.mjs --check"
  },
  "dependencies": {
    "@sentry/svelte": "11.11.0",
    "markdown-it": "15.0.3",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.9",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.0"
  }
}
