{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "vendir.yml"
      ],
      "commitMessageTopic": "vendored dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update vendir npm dependencies",
      "fileMatch": [
        "^vendir\\.yml$"
      ],
      "matchStrings": [
        "# renovate: datasource=npm depName=(?<depName>[^\\s]+)\\n\\s*- path:[^\\n]+\\n\\s*http:\\n\\s*url: https://registry\\.npmjs\\.org/(?:@[^/]+/)?[^/]+/-/[^-\\n]+-(?<currentValue>[^/\\s]+)\\.tgz"
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
