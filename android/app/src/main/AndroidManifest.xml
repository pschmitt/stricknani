<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- User-started data downloads and restores run as a dataSync foreground service on Android
         8-13 (API 26-33), so WorkManager's ten minute limit does not stop them. API 34+ uses
         user-initiated jobs instead. Scheduled backups never use it. The owner submits the Play
         Console foreground service declaration. FOREGROUND_SERVICE_DATA_SYNC is only enforced
         from API 34 but lint and target 34+ manifests require it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 34+ user-initiated data transfer jobs run "Download your data" and "Restore" without
         WorkManager's ten minute limit. A normal permission, no Play declaration, and no
         foreground service. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- API 33+ runtime permission for optional background sync result notifications (SNA-14).
         Sync never depends on it being granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR-code onboarding scanner (SNA-13) - requested at scan time, not on launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Package visibility (API 30+) so the editors can tell whether a camera app can take a photo. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".StricknaniApp"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/launcher_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stricknani"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Sentry is started by ErrorReportingController once the server
             offers it and the user allows it, never by the SDK's own content provider. The entry
             is inert in builds without the SDK. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- usesCleartextTraffic=true: self-hosted Stricknani instances are frequently plain
             HTTP on a local network (this app's whole audience is homelab/self-hosted users). -->

        <!-- WorkManager's foreground service for the user-started data download and restore on
             API 26-33 (see the permissions above). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- User-initiated data transfer jobs (API 34+) of the data download and restore; below
             API 34 the same transfers run as WorkManager workers. -->
        <service
            android:name=".data.export.DataExportJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".data.export.DataRestoreJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Stricknani.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Legacy and SPA project/yarn web links (SNA-17, SNA-75). No android:autoVerify:
                 every self-hosted Stricknani instance runs on a different, user-chosen domain, so
                 a single APK can't declare one verified host the way a single-tenant app would (see
                 android/TODO.md's SNA-17 entry) - android:host="*" plus the OS's normal
                 "Open with" chooser is the same tradeoff nyetbox makes for NetBox's self-hosted
                 URLs. -->
            <intent-filter tools:ignore="AppLinkWarning,IntentFilterUniqueDataAttributes">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="*" android:pathPattern="/projects/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/yarn/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/app/projects/.*" />
                <data android:scheme="https" android:host="*" android:pathPattern="/app/yarns/.*" />
            </intent-filter>
            <!-- Self-hosted Stricknani instances are frequently plain HTTP (see
                 usesCleartextTraffic above) - keep the same portable chooser behavior for those. -->
            <intent-filter tools:ignore="AppLinkWarning,IntentFilterUniqueDataAttributes">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" android:pathPattern="/projects/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/yarn/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/app/projects/.*" />
                <data android:scheme="http" android:host="*" android:pathPattern="/app/yarns/.*" />
            </intent-filter>
            <!-- Share a link to Stricknani from a browser or any app: the app asks whether to import
                 it as a project or a yarn and opens that import dialog with the link filled in. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Setup QR payloads (SNA-13) are self-identifying custom-scheme URIs, so a generic
                 camera app's own QR auto-detection can hand them back to this app too, not just
                 the in-app scanner - matches nyetbox's `nyetbox://setup` registration. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stricknani" android:host="setup" />
            </intent-filter>
            <!-- Return from the browser sign-in with the identity provider (OIDC): exactly
                 stricknani://oidc-callback. A custom scheme because App Links cannot be verified
                 for arbitrary self-hosted domains; the app accepts a callback only for a pending
                 in-memory flow, and the PKCE verifier proves the code is ours. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stricknani" android:host="oidc-callback" />
            </intent-filter>
        </activity>

        <!-- Per-app language picker (SNA-37): opts into AppCompat's own SharedPreferences-backed
             storage for the chosen locale on API < 33 (the platform's LocaleManager already
             persists it natively on API 33+). Without this, setApplicationLocales() would still
             apply immediately but wouldn't survive an app restart on older devices. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>

        <!-- Hands the camera app a write-only target for "Take photo" (cache/captures/ only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>

        <!-- WorkManager will be initialized manually (Configuration.Provider) once SNA-7 adds
             HiltWorkerFactory injection - disable the default ContentProvider-based auto-init
             now so that doesn't require another manifest change later. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
